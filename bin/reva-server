#!/data/data/com.termux/files/usr/bin/bash
# ReVa headless MCP server（Ghidra 12.1.3 + reverse-engineering-assistant 7.3.1）
#
# 用法：
#   reva-server start|stop|restart|status|log
#
# 说明：
#   - Ghidra 装在 $HOME/tools/ghidra/ghidra_12.1.3_PUBLIC（官方发行包 + 本机自编的
#     aarch64 原生 decompiler/sleigh，见 $HOME/tools/decompiler-build/）。
#   - ReVa 扩展装在 <ghidra>/Extensions/Ghidra/reva；启动器 reva.local.RevaServerMain
#     打包在 <ghidra>/Extensions/Ghidra/reva/lib/reva-server.jar。
#   - 监听 127.0.0.1:8080（streamable HTTP，endpoint /mcp/message），只对本机开放。
#   - 这个 Java 进程是独立会话（setsid），不随当前 shell 退出而结束。
set -uo pipefail

HOME_DIR="${HOME:-/data/data/com.termux/files/home}"
GHIDRA_DIR="${GHIDRA_DIR:-$HOME_DIR/tools/ghidra/ghidra_12.1.3_PUBLIC}"
REVA_DIR="${REVA_DIR:-$HOME_DIR/tools/reva-server}"
CONFIG="$REVA_DIR/reva-headless.properties"
PROJECT_DIR="$REVA_DIR/projects"
PROJECT_NAME="${REVA_PROJECT_NAME:-reva}"
LOG="${REVA_LOG:-$HOME_DIR/.codex/reva-server.log}"
PIDFILE="$HOME_DIR/.codex/reva-server.pid"
PORT="${REVA_PORT:-8080}"
HEAP="${REVA_HEAP:-4G}"

die() { printf 'reva-server: %s\n' "$1" >&2; exit 1; }

pid_of() {
	[ -f "$PIDFILE" ] || return 1
	local pid
	pid="$(cat "$PIDFILE" 2>/dev/null)"
	[ -n "$pid" ] || return 1
	kill -0 "$pid" 2>/dev/null || return 1
	printf '%s' "$pid"
}

port_up() {
	curl -s -m 3 -o /dev/null "http://127.0.0.1:${PORT}/mcp/message" || return 1
	return 0
}

classpath() {
	[ -d "$GHIDRA_DIR" ] || die "找不到 Ghidra：$GHIDRA_DIR"
	find "$GHIDRA_DIR" -name '*.jar' | tr '\n' ':'
}

start() {
	if pid_of >/dev/null; then
		printf 'reva-server: 已在运行（pid %s）\n' "$(pid_of)"
		return 0
	fi
	[ -f "$CONFIG" ] || die "找不到配置：$CONFIG"
	mkdir -p "$PROJECT_DIR" "$(dirname "$LOG")"
	CP="$(classpath)"
	cd "$GHIDRA_DIR" || die "无法进入 $GHIDRA_DIR"
	setsid nohup java -Xmx"$HEAP" -Dghidra.install.dir="$GHIDRA_DIR" -cp "$CP" \
		reva.local.RevaServerMain "$CONFIG" "$PROJECT_DIR" "$PROJECT_NAME" \
		>>"$LOG" 2>&1 &
	printf '%s' "$!" >"$PIDFILE"
	printf 'reva-server: 启动中（pid %s），日志 %s\n' "$!" "$LOG"
	exit 0
}

stop() {
	local pid
	if ! pid="$(pid_of)"; then
		printf 'reva-server: 未在运行\n'
		rm -f "$PIDFILE"
		return 0
	fi
	kill "$pid" 2>/dev/null
	for _ in $(seq 1 60); do
		kill -0 "$pid" 2>/dev/null || break
		sleep 0.5
	done
	kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
	rm -f "$PIDFILE"
	printf 'reva-server: 已停止（pid %s）\n' "$pid"
}

status() {
	local pid state="未运行"
	if pid="$(pid_of)"; then
		if port_up; then
			state="运行中（pid $pid，http://127.0.0.1:${PORT}/mcp/message 已就绪）"
		else
			state="进程在（pid $pid）但端口 ${PORT} 还没起来"
		fi
	fi
	printf 'reva-server: %s\n' "$state"
	printf '  Ghidra: %s\n  ReVa:   %s\n  日志:   %s\n' "$GHIDRA_DIR" "$REVA_DIR" "$LOG"
	if port_up; then
		printf '  端口:   %s\n' "$(curl -s -m 3 -o /dev/null -w '%{http_code}' "http://127.0.0.1:${PORT}/mcp/message")"
	fi
}

case "${1:-status}" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	status) status ;;
	log) tail -n "${2:-40}" "$LOG" ;;
	*) die "用法：reva-server start|stop|restart|status|log" ;;
esac
