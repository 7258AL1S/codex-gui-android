<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标的底色：深色竖向渐变（与 design/icon-master.svg 一致）。
     用 shape 而不是 vector，是为了避开旧 aapt 对 vector 内联渐变的兼容问题。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#1B1B20"
        android:centerColor="#111114"
        android:endColor="#050507"/>
</shape>
